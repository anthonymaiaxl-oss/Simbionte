# ── n8n ──────────────────────────────────────────────────────────
# Sem estas duas, o painel sobe com os dados de exemplo em vez de
# quebrar. Copie para .env.local e preencha.

# Raiz da sua instância, SEM barra no fim e SEM /webhook.
# n8n Cloud: https://SUACONTA.app.n8n.cloud
N8N_BASE_URL=

# Segredo compartilhado. Gere um valor longo e aleatório e cadastre o
# MESMO valor no n8n, como credencial "Header Auth" com:
#   Name:  X-Simbionte-Token
#   Value: (este valor)
# Anexe essa credencial em TODOS os nós de Webhook do painel — sem ela,
# qualquer pessoa que descubra a URL dispara seus fluxos.
N8N_TOKEN=
